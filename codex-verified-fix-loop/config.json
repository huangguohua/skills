  "codebase": {
    "backend_path": "",
    "frontend_path": "",
    "backend_framework": "",
    "frontend_framework": ""
  },
  "diagnostics": {
    "_comment": "定位问题的可选信息源。无则留空；本 Skill 不依赖任何特定来源，按需取用。",
    "prod_log_access": {
      "_comment": "生产日志获取方式。ssh 命令模板，<X> 为占位；无远程访问时置 null。敏感凭证走本机 ~/.ssh，禁止写入本文件。",
      "type": "ssh",
      "host": "",
      "port": 22,
      "user": "",
      "identity_file": "",
      "log_path": ""
    },
    "coding_standards_path": "doc/development/coding-standards.md",
    "backend_gotchas_path": "doc/development/backend-gotchas.md",
    "frontend_gotchas_path": "doc/development/frontend-gotchas.md"
  },
  "review": {
