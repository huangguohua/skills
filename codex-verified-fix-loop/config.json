    "blocking_levels": [
      "HIGH",
      "MEDIUM"
    ],
    "deferrable_levels": [
      "LOW",
      "SUGGESTION"
    ],
    "resume_same_thread": true,
    "max_rounds": 4
  },
  "handoff": {
    "_comment": "循环通过后可选衔接的下游动作。本 Skill 只提示，不自动触发高风险步骤。",
    "suggest_build": true,
    "suggest_test": true,
    "suggest_deploy_skill": "project-release-deploy",
    "high_risk_requires_user_confirm": true
