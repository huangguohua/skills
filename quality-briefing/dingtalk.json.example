{
  "_说明": "复制本文件为 dingtalk.json 并填入真实值；dingtalk.json 已被 gitignore，不会提交。也可改用同名环境变量。",
  "DINGTALK_APP_KEY": "你的企业内部应用 AppKey",
  "DINGTALK_APP_SECRET": "你的企业内部应用 AppSecret",
  "DINGTALK_ROBOT_CODE": "机器人编码（企业内部应用机器人通常等于 AppKey，可留空自动取 AppKey）",
  "DINGTALK_OPEN_CONVERSATION_ID": "目标群的 openConversationId（把机器人加入群后获取）"
}
